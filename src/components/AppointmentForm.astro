---
import Icon from './Icon.astro';
---
<div class="appointment-card">
<div class="form-heading"><span class="availability-dot"></span> Empecemos por conocernos</div>
<p class="form-description">Solo necesitamos tu nombre y un teléfono. Si aún no sabes qué necesitas, lo vemos contigo.</p>
<form id="appointment-form" method="post" novalidate>
<div class="form-row">
<div class="field"><label for="name">Tu nombre</label><input id="name" name="name" autocomplete="given-name" placeholder="Ej. Clara…" required maxlength="80" aria-describedby="name-error"/><div class="error-slot"><p id="name-error" class="field-error" hidden></p></div></div>
<div class="field"><label for="phone">Tu teléfono</label><input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="Ej. 612 345 678…" required maxlength="20" title="Introduce tu número de teléfono." aria-describedby="phone-error"/><div class="error-slot"><p id="phone-error" class="field-error" hidden></p></div></div>
</div>
<div class="field"><label for="treatment">¿Qué te trae por aquí? (opcional)</label><select name="treatment" id="treatment"><option value="" disabled selected>Puedes decidirlo en la visita</option><option>Una revisión para empezar</option><option>Ortodoncia invisible</option><option>Estética dental</option><option>Implantes dentales</option><option>Quiero que me orientéis</option></select></div>
<label class="consent"><input name="consent" type="checkbox" required aria-describedby="consent-error"/><span>Entiendo que esta es una demo y que la solicitud no se enviará a una clínica real.</span></label>
<div class="consent-error-slot"><p id="consent-error" class="field-error" hidden></p></div>
<button class="button form-submit" type="submit" disabled>Probar solicitud de cita <Icon name="diagonal" size={20}/></button>
<p class="form-note">Formulario de demostración. No guardamos ni enviamos tus datos.</p>
<noscript><p>Activa JavaScript para probar esta demo; no se realizan envíos reales.</p></noscript>
</form>
<div id="form-success" class="form-success" hidden tabindex="-1"><span class="success-icon"><Icon name="check" size={32}/></span><h3>Así empieza una sonrisa Brava.</h3><p>La demostración ha terminado. En una clínica real, el equipo te contactaría para acordar el día y la hora. No se ha enviado ni guardado ningún dato.</p><button id="form-reset" class="text-button" type="button">Probar otra solicitud <Icon name="arrow" size={18}/></button></div>
<p id="form-status" class="sr-only" role="status" aria-live="polite"></p>
</div>
<script>
const form = document.querySelector<HTMLFormElement>('#appointment-form');
const success = document.querySelector<HTMLElement>('#form-success');
const status = document.querySelector<HTMLElement>('#form-status');
const submit = form?.querySelector<HTMLButtonElement>('[type="submit"]');
if (submit) submit.disabled = false;
function validateField(field: HTMLInputElement) {
 const digits = field.value.replace(/\D/g, '');
 const message = field.name === 'name' ? (!field.value.trim() ? 'Escribe tu nombre.' : '') : (!field.value.trim() ? 'Escribe tu teléfono.' : digits.length < 9 || digits.length > 15 || !/^\+?[0-9 ()-]+$/.test(field.value) ? 'Usa entre 9 y 15 dígitos.' : '');
 const error = document.querySelector<HTMLElement>('#' + field.id + '-error');
 field.setAttribute('aria-invalid', String(Boolean(message)));
 if (error) { error.textContent = message; error.hidden = !message; }
 return !message;
}
form?.querySelectorAll<HTMLInputElement>('#name, #phone').forEach(field => {
 field.addEventListener('blur', () => validateField(field));
 field.addEventListener('input', () => { if (field.getAttribute('aria-invalid') === 'true') validateField(field); });
});
form?.addEventListener('submit', event => {
 event.preventDefault(); if (!success) return;
 const invalid = [...form.querySelectorAll<HTMLInputElement>('#name, #phone')].filter(field => !validateField(field));
 if (invalid.length) { if (status) status.textContent = 'Revisa los campos indicados.'; invalid[0].focus(); return; }
 const consent = form.querySelector<HTMLInputElement>('[name="consent"]');
 const consentError = document.querySelector<HTMLElement>('#consent-error');
 if (consentError) { consentError.hidden = Boolean(consent?.checked); consentError.textContent = consent?.checked ? '' : 'Confirma que entiendes que es una demo.'; }
 consent?.setAttribute('aria-invalid', String(!consent.checked));
 if (!consent?.checked) { if (status) status.textContent = 'Confirma que entiendes que esta es una demo.'; consent?.focus(); return; }
 form.reset(); form.hidden = true; success.hidden = false;
 if (status) status.textContent = 'Demostración completada. No se ha enviado ni guardado ningún dato.';
 success.focus();
});
document.querySelector('#form-reset')?.addEventListener('click', () => { if (!form || !success) return; success.hidden = true; form.hidden = false; if (status) status.textContent = ''; document.querySelector<HTMLInputElement>('#name')?.focus(); });
document.querySelectorAll<HTMLAnchorElement>('[data-treatment]').forEach(link => link.addEventListener('click', () => { if (!form || !success) return; form.hidden = false; success.hidden = true; const select = document.querySelector<HTMLSelectElement>('#treatment'); if (select) select.value = link.dataset.treatment ?? ''; }));
</script>

<script>
const consentCheckbox = document.querySelector<HTMLInputElement>('[name="consent"]');
consentCheckbox?.addEventListener('change', () => {
 const message = document.querySelector<HTMLElement>('#consent-error');
 if (consentCheckbox.checked && message) { message.hidden = true; message.textContent = ''; consentCheckbox.setAttribute('aria-invalid', 'false'); }
});
</script>
