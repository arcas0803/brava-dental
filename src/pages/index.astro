---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
import { Image } from 'astro:assets';
import smile from '../../public/images/brava-smile.webp';
import studio from '../../public/images/studio.webp';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import AppointmentForm from '../components/AppointmentForm.astro';
const services = [
 {n:'01', title:'Salud dental', text:'Revisiones, higiene y cuidado de las encías. Empezar por lo que importa.', value:'Una revisión para empezar', icon:'tooth'},
 {n:'02', title:'Ortodoncia invisible', text:'Estudiamos cómo alinear tu sonrisa con un plan que encaje contigo.', value:'Ortodoncia invisible', icon:'align'},
 {n:'03', title:'Estética dental', text:'Exploramos las opciones para tu sonrisa, respetando su personalidad.', value:'Estética dental', icon:'sparkle'},
 {n:'04', title:'Implantes dentales', text:'Valoramos tu caso y te explicamos las alternativas para recuperar piezas.', value:'Implantes dentales', icon:'implant'},
];
const questions = [
 ['Hace mucho que no voy al dentista. ¿Por dónde empiezo?', 'Por una revisión y una conversación. No necesitas saber qué tratamiento quieres: el primer paso es conocer tu situación y resolver tus dudas.'],
 ['¿Y si me da miedo ir al dentista?', 'Cuéntalo desde el principio. La propuesta de Brava es escucharte, explicar cada paso y acordar un ritmo con el que te sientas cómodo.'],
 ['¿Cómo sé qué tratamiento necesito?', 'La elección depende de una valoración profesional. La información de esta página es general; no sustituye una exploración ni un diagnóstico.'],
 ['¿Puedo conocer el presupuesto antes de decidir?', 'Sí: el concepto de Brava contempla explicar las opciones, el plan y el presupuesto antes de empezar. En esta demo no se ofrecen precios ni reservas reales.'],
];
---
<Layout><Header/><main id="contenido">
<section class="hero" aria-labelledby="hero-title">
 <div class="hero-heading wrap"><div class="hero-copy"><span class="eyebrow">ODONTOLOGÍA CON OTRA ACTITUD · MADRID</span><h1 id="hero-title">Tu sonrisa,<br/><span>tus reglas.</span></h1><div class="hero-intro"><p>Un dentista que te escucha.<br/>Un plan que entiendes.</p><p class="muted">Una nueva forma de cuidar tu salud dental: cercana, sin prisas y con las cosas claras.</p><a class="button" href="#cita">Pide tu primera cita <Icon name="diagonal" size={20}/></a><a href="#tratamientos" class="hero-secondary">Explora los tratamientos <Icon name="arrow" size={18}/></a></div></div><figure class="portrait"><Image src={smile} widths={[400, 600, 850, 1122]} sizes="(max-width: 600px) calc(100vw - 56px), (max-width: 900px) 40vw, 405px" format="webp" quality={80} loading="eager" fetchpriority="high" alt="Retrato de campaña: una mujer sonríe con naturalidad"/><figcaption><span>Una sonrisa muy tuya.</span><Icon name="sparkle" size={20}/></figcaption></figure></div><div class="hero-values wrap"><div><span>01</span> Te escuchamos de verdad.</div><div><span>02</span> Las cosas, claras.</div><div><span>03</span> El siguiente paso lo eliges tú.</div></div>
</section>

<section id="tratamientos" class="services wrap section" aria-labelledby="services-title"><div class="section-lead"><span class="eyebrow">CUIDAMOS LO QUE TE HACE SONREÍR</span><h2 id="services-title">Lo que necesitas.<br/><span>Sin complicarlo.</span></h2><p>No hace falta que tengas un plan. Podemos empezar por una revisión y encontrar contigo el siguiente paso.</p></div><div class="service-list">{services.map(s=><a class="service-row" href="#cita" data-treatment={s.value}><div class="service-card-top"><span class="service-number">{s.n}</span><span class="service-icon"><Icon name={s.icon} size={44}/></span></div><div class="service-card-copy"><h3>{s.title}</h3><p>{s.text}</p></div><span class="service-action"><span>Pide tu primera cita</span><span class="round-arrow"><Icon name="diagonal" size={22}/></span></span></a>)}</div></section>
<section id="filosofia" class="philosophy section" aria-labelledby="philosophy-title"><div class="wrap philosophy-grid"><div class="philosophy-copy"><span class="eyebrow">EL ESPÍRITU BRAVA</span><h2 id="philosophy-title">Primero tú.<br/><span>Siempre tú.</span></h2><p>Tu historia importa tanto como tu sonrisa. Queremos que puedas preguntar, entender y decidir sin sentir que vas contrarreloj.</p><div class="principles"><div><Icon name="heart"/><h3>Te escuchamos.</h3><p>Una conversación antes de un plan.</p></div><div><Icon name="check"/><h3>Te lo explicamos.</h3><p>Opciones claras. Decisiones contigo.</p></div></div></div><figure class="studio"><Image src={studio} widths={[400, 700, 1000]} sizes="(max-width: 600px) calc(100vw - 60px), (max-width: 900px) 40vw, 520px" format="webp" quality={80} loading="lazy" alt="Interior luminoso, referencia visual para el concepto Brava"/><figcaption>Un espacio para bajar las revoluciones.<small>Imagen de inspiración, no corresponde a una clínica real.</small></figcaption></figure></div></section>
<section class="visit wrap section" aria-labelledby="visit-title"><div class="visit-title"><span class="eyebrow">TU PRIMERA VISITA</span><h2 id="visit-title">Empieza con<br/>un <span>hola.</span></h2><p>No necesitas tenerlo todo claro.<br/>Para eso es la primera conversación.</p></div><ol class="steps"><li><span>01</span><div><h3>Nos cuentas.</h3><p>Qué te preocupa, qué buscas y cómo te gustaría sentirte.</p></div></li><li><span>02</span><div><h3>Lo vemos juntos.</h3><p>Una valoración para entender tu salud dental y las opciones.</p></div></li><li><span>03</span><div><h3>Tú decides.</h3><p>Un plan explicado con calma. El siguiente paso lo eliges tú.</p></div></li></ol></section>
<section id="preguntas" class="faq-section section" aria-labelledby="faq-title"><div class="wrap faq-grid"><div><span class="eyebrow">PREGUNTAR TAMBIÉN ES CUIDARTE</span><h2 id="faq-title">Lo hablamos.<br/><span>Sin rodeos.</span></h2></div><div class="faq-list">{questions.map(([q,a])=><details><summary>{q}<span class="faq-plus" aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></div></section>
<section id="cita" class="contact section" aria-labelledby="contact-title"><div class="wrap contact-grid"><div class="contact-copy"><span class="eyebrow">EL SIGUIENTE PASO ES PEQUEÑO</span><h2 id="contact-title">Vamos a<br/>conocernos<span class="contact-dot">.</span></h2><p>Cuéntanos un poco de ti.<br/>Tu sonrisa pone el resto.</p><div class="demo-caption"><Icon name="location" size={20}/><span>Concepto de clínica en Madrid.<br/>Explora cómo sería pedir tu primera cita.</span></div></div><AppointmentForm/></div></section>
</main><footer class="footer wrap"><div class="footer-top"><a class="footer-logo" href="#" translate="no" aria-label="BRAVA Dental Studio, inicio">brava<Icon name="sparkle" size={38}/></a><p>Tu sonrisa no tiene que ser perfecta.<br/>Tiene que ser tuya.</p><a class="back-top" href="#">Volver arriba <Icon name="arrow" size={20}/></a></div><div class="footer-bottom"><span>© 2026 BRAVA · Concepto creativo · <a href={`${base}caso-de-estudio/`}>Caso de estudio</a></span><span>Proyecto de demostración. Clínica y contenidos ficticios; imágenes ilustrativas.</span></div></footer>

</Layout>
